{
  "opencollection": "1.0.0",
  "info": {
    "name": "Matrix Client-Server Account API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the current user ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{homeserver}/_matrix/client/v3/account/whoami"
          },
          "docs": "Get the current user ID"
        }
      ]
    }
  ],
  "bundled": true
}