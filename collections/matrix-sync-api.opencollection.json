              },
              {
                "name": "timeout",
                "value": "",
                "type": "query"
              },
              {
                "name": "full_state",
                "value": "",
                "type": "query"
              },
              {
                "name": "set_presence",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Synchronize client state with the server"
        }
      ]
    }
  ],
  "bundled": true
}